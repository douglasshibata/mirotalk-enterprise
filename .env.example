# ==============================================================================
# ENTERPRISE WEBRTC VIDEOCONFERENCE (MIROTALK SFU + COTURN + GATEWAY) ENV FILE
# ==============================================================================

# Public IPv4 address or domain of your VPS/Server (Required for MediaSoup to announce itself)
PUBLIC_IP=1.2.3.4
DOMAIN_NAME=rtc.company.com

# Gateway API configuration
PORT=4000

# Security Secrets
# JWT Secret used to generate and verify tokens allowing access to secured MiroTalk Rooms
JWT_SECRET=super_secret_enterprise_jwt_signing_key_2026
JWT_EXPIRATION=1h

# Shared REST API Secret between the Gateway and MiroTalk SFU
API_KEY_SECRET=mirotalksfu_secure_enterprise_secret_key_99

# --- Coturn (STUN/TURN) Server Configuration ---
# Admin secret key for TURN authentication (used to generate transient dynamic credentials)
TURN_SECRET=very_secure_turn_static_auth_secret_key

# Custom Realm for TURN Server
TURN_REALM=company.com
